# Copy to .env and fill in.
CRUSTDATA_API_KEY=
GROQ_API_KEY=

# Optional
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
CREDIT_CAP_PER_INVESTIGATION=25
CRUSTDATA_TECHNOGRAPHICS=auto      # auto | off
REPLAY_MODE=0                      # 1 = offline demo from cache only
MANUAL_BENCHMARK_HOURS=16          # placeholder benchmark shown in the UI
MANUAL_BENCHMARK_COST_INR=15000    # placeholder benchmark shown in the UI
